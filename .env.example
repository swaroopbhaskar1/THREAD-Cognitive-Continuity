# Names only: no working credentials are included.
# Replit injects Secrets/environment variables; this file is not auto-loaded.
# Development and database tests must use your OWN disposable PostgreSQL database.
DATABASE_URL=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_OPENAI_API_KEY=
# Optional Clerk proxy setting; depends on your routing/tenant configuration.
VITE_CLERK_PROXY_URL=
# Production only: never reuse the development database.
THREAD_PRODUCTION_DATABASE_URL=
THREAD_PRODUCTION_DATABASE_HOST=
THREAD_PRODUCTION_DATABASE_NAME=
# Optional notifications; leave monitoring disabled unless explicitly configured.
THREAD_MONITOR_ENABLED=false
THREAD_ALERT_FROM=
THREAD_ALERT_TO=
